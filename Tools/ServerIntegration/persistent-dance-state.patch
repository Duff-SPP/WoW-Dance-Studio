+    bool IsAdditionalDanceState(uint32 emoteId)
+    {
+        if (emoteId == EMOTE_STATE_DANCE || emoteId == EMOTE_ONESHOT_NONE)
+            return false;
+
+        EmotesEntry const* emote = sEmotesStore.LookupEntry(emoteId);
+        EmotesEntry const* dance = sEmotesStore.LookupEntry(EMOTE_STATE_DANCE);
+        return emote && dance && emote->Flags == dance->Flags &&
+            emote->EmoteType == dance->EmoteType && emote->UnitStandState == dance->UnitStandState;
+    }
+
+    void ClearAdditionalDanceState(Player* player)
+    {
+        if (IsAdditionalDanceState(player->GetUInt32Value(UNIT_NPC_EMOTESTATE)))
+            player->SetUInt32Value(UNIT_NPC_EMOTESTATE, EMOTE_ONESHOT_NONE);
+    }
+}
